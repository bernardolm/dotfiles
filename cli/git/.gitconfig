[apply]
	whitespace = fix

[commit]
	gpgsign = true

[core]
	editor = nano
	autocrlf = false

# [diff]
# 	colorMoved = default

[fetch]
	prune = true

# [filter "lfs"]
#	required = true
#	clean = git-lfs clean -- %f
#	smudge = git-lfs smudge -- %f
#	process = git-lfs filter-process

[gpg]
  format = ssh

[init]
  defaultBranch = main

[merge]
  log = true
  conflictStyle = zdiff3

# [pull]
#	rebase = true

[push]
  autoSetupRemote = true

[rebase]
  autoStash = true

[status]
  short = false

# [submodule]
#	recurse = true

[url "git@github.com:"]
	insteadOf = https://github.com/

# # wezterm's plugin loader (libgit2) can't follow the ssh rewrite above,
# # so keep plain https for its plugin repos.
# [url "https://github.com/yriveiro/wezterm-status"]
#	insteadOf = https://github.com/yriveiro/wezterm-status
